# PrimeBrew Herbis - Environment Variables Configuration
# Copy this file to .env.local for local development.

# Application Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Authentication Secrets & Settings
JWT_SECRET=primebrew_herbis_jwt_super_secret_key_2026_change_in_prod
JWT_REFRESH_SECRET=primebrew_herbis_jwt_refresh_secret_key_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES=30d

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/primebrew_herbis?retryWrites=true&w=majority

# Cloudinary Media Storage Integration
CLOUDINARY_CLOUD_NAME=primebrew-herbis
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Payment Gateway - Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Payment Gateway - Stripe Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Email Notification & OTP Services (Nodemailer SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="PrimeBrew Herbis <noreply@primebrewherbis.com>"

# Google OAuth 2.0 Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Shiprocket Order Delivery Integration
SHIPROCKET_EMAIL=shipping@primebrewherbis.com
SHIPROCKET_PASSWORD=your_shiprocket_account_password

# Redis Caching Layer (Optional)
REDIS_URL=redis://default:password@localhost:6379

# Analytics Tracking
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Security & Session Secrets
SESSION_SECRET=primebrew_session_secret_key_2026
COOKIE_SECRET=primebrew_cookie_secret_key_2026

# Seed Admin Account Credentials for Initial Setup
ADMIN_EMAIL=admin@primebrewherbis.com
ADMIN_PASSWORD=Admin@12345

# Website URLs
SITE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000